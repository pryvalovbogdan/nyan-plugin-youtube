{
  "name": "nyan-plugin-youtube",
  "version": "1.1.4",
  "description": "Nyan cat in youtube bar extension",
  "main": "src/js/contentScript.js",
  "scripts": {
    "test": "vitest run",
    "style-fix": "stylelint \"src/styles/**/*.{css,scss}\" --fix",
    "clean": "rm -rf dist",
    "clean:safari": "rm -rf dist-safari",
    "build:js": "esbuild src/js/contentScript.js background=src/js/background/index.js src/js/popup.js src/js/websiteContentScript.js --bundle --minify --target=es2020 --define:__NYAN_DEBUG__=false --define:__SAFARI__=false --outdir=dist",
    "build:js:safari": "esbuild src/js/contentScript.js background=src/js/background/index.js src/js/popup.js src/js/websiteContentScript.js --bundle --minify --target=es2020 --define:__NYAN_DEBUG__=false --define:__SAFARI__=true --outdir=dist-safari",
    "build:js:watch": "esbuild src/js/contentScript.js background=src/js/background/index.js src/js/popup.js src/js/websiteContentScript.js --bundle --target=es2020 --define:__NYAN_DEBUG__=true --define:__SAFARI__=false --outdir=dist --watch",
    "build:css": "mkdir -p dist && csso src/styles/content.css --output dist/content.css && csso src/styles/popup.css --output dist/popup.css",
    "build:css:safari": "mkdir -p dist-safari && csso src/styles/content.css --output dist-safari/content.css && csso src/styles/popup.css --output dist-safari/popup.css",
    "build:css:watch": "chokidar 'src/styles/**/*.css' -c 'yarn build:css'",
    "build:static:watch": "chokidar 'manifest.json' 'popup.html' -c 'yarn copy:manifest && yarn copy:html'",
    "copy:html": "cp *.html dist/",
    "copy:html:safari": "cp *.html dist-safari/",
    "copy:manifest": "node scripts/sync-manifest.mjs",
    "copy:manifest:safari": "BUILD_TARGET=safari node scripts/sync-manifest.mjs",
    "copy:icons": "node scripts/copy-assets.mjs",
    "copy:icons:safari": "BUILD_TARGET=safari node scripts/copy-assets.mjs",
    "build": "yarn clean && yarn build:js && yarn build:css && yarn copy:html && yarn copy:manifest && yarn copy:icons",
    "build:safari": "yarn clean:safari && yarn build:js:safari && yarn build:css:safari && yarn copy:html:safari && yarn copy:manifest:safari && yarn copy:icons:safari",
    "dev": "yarn build && concurrently -n js,css,static,chrome \"yarn build:js:watch\" \"yarn build:css:watch\" \"yarn build:static:watch\" \"web-ext run --target chromium --source-dir dist\"",
    "lint": "eslint src/js/**/*.js",
    "lint:fix": "eslint src/js/**/*.js --fix",
    "zip": "yarn build && cd dist && zip -r ../extension.zip . && cd -",
    "zip:safari": "yarn build:safari && cd dist-safari && zip -r ../extension-safari.zip . && cd -",
    "test:watch": "vitest",
    "style-check": "stylelint \"src/styles/**/*.{css,scss}\"",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pryvalovbogdan/nyan-plugin-youtube.git"
  },
  "author": "Bogdan Pryvalov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pryvalovbogdan/nyan-plugin-youtube/issues"
  },
  "type": "module",
  "homepage": "https://github.com/pryvalovbogdan/nyan-plugin-youtube#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "chokidar-cli": "^3.0.0",
    "chrome-types": "^0.1.429",
    "concurrently": "^9.2.1",
    "csso-cli": "^4.0.2",
    "esbuild": "^0.25.11",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.6.2",
    "stylelint": "^16.25.0",
    "stylelint-config-css-modules": "^4.5.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-prettier": "^5.0.3",
    "vitest": "^4.1.8",
    "web-ext": "^10.3.0"
  }
}
